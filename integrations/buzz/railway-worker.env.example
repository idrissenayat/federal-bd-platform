# Non-secret Railway variables shared by every hosted STEER Buzz worker.
# One Railway service and one unique BUZZ_PRIVATE_KEY are required per identity.
RAILWAY_DOCKERFILE_PATH=/integrations/buzz/Dockerfile.worker
BUZZ_RELAY_URL=wss://blockbuzzmain-production-5bcb.up.railway.app
BUZZ_ACP_AGENT_COMMAND=/usr/local/bin/buzz-agent
BUZZ_ACP_AGENT_ARGS=
BUZZ_ACP_MCP_COMMAND=/usr/local/bin/buzz-dev-mcp
BUZZ_ACP_AGENTS=1
BUZZ_ACP_RESPOND_TO=owner-only
# Required with owner-only unless BUZZ_AUTH_TAG is supplied. This is the human
# owner's 64-character public key, never a private key.
BUZZ_ACP_AGENT_OWNER=
BUZZ_AGENT_REQUIRE_REPLY=1
BUZZ_AGENT_PROVIDER=openai
OPENAI_COMPAT_BASE_URL=https://api.openai.com/v1
OPENAI_COMPAT_API=responses
OPENAI_COMPAT_MODEL=gpt-5.6-luna
BUZZ_AGENT_MAX_ROUNDS=12

# Set these only in Railway's sealed service variables. Never commit values.
BUZZ_PRIVATE_KEY=
OPENAI_COMPAT_API_KEY=
BUZZ_AGENT_SYSTEM_PROMPT=

# Optional shared-service mode. This keeps separately signed agent identities in
# one Railway container when the account cannot provision one service per role.
# The Builder continues to use the three legacy variables above. Every added
# role has its own sealed private key, role prompt, and model selection.
STEER_AGENT_ROLES=builder,architect
STEER_AGENT_PROCESS_COUNT=1
STEER_ARCHITECT_BUZZ_PRIVATE_KEY=
STEER_ARCHITECT_SYSTEM_PROMPT=
STEER_ARCHITECT_MODEL=gpt-5.6-sol
STEER_ARCHITECT_GITHUB_SSH_PRIVATE_KEY=
STEER_ARCHITECT_GIT_NAME=STEER Architect Agent
STEER_ARCHITECT_GIT_EMAIL=steer-architect-agent@users.noreply.github.com
STEER_GIT_REMOTE_URL=ssh://git@ssh.github.com:443/idrissenayat/federal-bd-platform.git
