# Obtain a personal public API key from the SAM.gov account details page.
SAM_API_KEY=
SAM_API_BASE_URL=https://api.sam.gov/opportunities/v2/search

# USAspending's public API is used for historical award context.
USASPENDING_API_BASE_URL=https://api.usaspending.gov/api/v2

# Application services. Replace all example values outside local development.
DATABASE_URL=postgresql://federal_bd:federal_bd_local_only@127.0.0.1:55432/federal_bd
POSTGRES_PORT=55432
OBJECT_STORE_MODE=filesystem
OBJECT_STORE_PATH=./data/raw

# No production model is selected during setup. Provider access is activated only
# after the provenance and redaction tests pass.
ANALYSIS_PROVIDER=
ANALYSIS_MODEL=
ANALYSIS_API_KEY=
